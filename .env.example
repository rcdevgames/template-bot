# Telegram
BOT_TOKEN=

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Security
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-exactly-32-characters
ENCRYPTION_ALGORITHM=aes-256-gcm

# Admin Telegram user ID
ADMIN_ID=

# Database driver: postgres | mysql | sqlite
DB_DRIVER=postgres

# PostgreSQL (waw_bridge example)
DB_HOST=postgresql_db
DB_PORT=5432
DB_NAME=template_bot
DB_USER=postgres
DB_PASSWORD=
# DATABASE_URL=postgresql://postgres:password@postgresql_db:5432/template_bot

# MySQL / MariaDB
# DB_HOST=mysql_db
# DB_PORT=3306
# DB_NAME=template_bot
# DB_USER=root
# DB_PASSWORD=
# DATABASE_URL=mysql://root:password@mysql_db:3306/template_bot

# SQLite
# DB_PATH=./data/app.sqlite

# Optional generic connection string override
# DATABASE_URL=

# Existing Docker network
DOCKER_NETWORK=waw_bridge

# Note: keep .env local. Never commit real tokens/passwords.

